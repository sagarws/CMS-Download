{
  "name": "downlodlink",
  "version": "1.0.0",
  "description": "Small API that streams a file download from a URL configured in .env",
  "main": "index.js",
  "scripts": {
    "build": "esbuild index.js --bundle --platform=node --target=node18 --outfile=dist/server.js",
    "start": "node index.js",
    "start:prod": "node dist/server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=18"
  }
}
